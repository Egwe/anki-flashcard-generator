# Required model in LiteLLM's provider/model notation.
ANKI_MODEL=ollama/llama3.2

# Optional for a custom endpoint, for example a local OpenAI-compatible server.
# LLM_API_BASE=http://localhost:11434
# LLM_API_KEY=

# Set only the key for the provider you use. Never commit real keys.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# MOONSHOT_API_KEY=
