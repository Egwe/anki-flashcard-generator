# =============================================================================
# NUR ZUGANGSDATEN - Modelle und Endpunkte stehen in config.yaml
# =============================================================================
# 1. cp .env.example .env
# 2. Nur den benoetigten Platzhalter durch deinen echten API-Token ersetzen.
# 3. Niemals .env committen oder Tokens in config.yaml schreiben.
#
# ANKI_MODEL und LLM_API_BASE gehoeren HIER NICHT mehr hin.
# Die YAML-Datei steuert Modelle und Endpunkte; explizite CLI-Werte haben Vorrang.

# OpenAI: https://platform.openai.com/api-keys
# Profile: openai-default, openai-native-pdf
OPENAI_API_KEY=dein-openai-token-hier

# Anthropic: https://console.anthropic.com/settings/keys
# Profil: anthropic-default
ANTHROPIC_API_KEY=dein-anthropic-token-hier

# Google AI Studio / Gemini: https://aistudio.google.com/apikey
# Profil: gemini-default
GEMINI_API_KEY=dein-gemini-token-hier

# Moonshot / Kimi: https://platform.moonshot.ai/console/api-keys
# Profil: moonshot-default
MOONSHOT_API_KEY=dein-moonshot-token-hier

# Optional: eigener OpenAI-kompatibler Server aus config.yaml.
# Nur setzen, wenn dieser Server einen Token verlangt.
CUSTOM_LLM_API_KEY=dein-custom-server-token-hier

# Optional: Ollama mit eigener Authentifizierung, z.B. Reverse Proxy.
# Normaler Ollama-Betrieb braucht keinen API-Token.
OLLAMA_API_KEY=dein-ollama-token-hier

# Optional: andere Datei als ./config.yaml auswaehlen.
# Dies ist KEIN Modell-/Endpunkt-Override, sondern nur der YAML-Dateipfad.
# ANKI_CONFIG=/absoluter/pfad/zu/config.yaml
